[Unit]
Description=Owner-controlled Kurd authenticated relay
Documentation=file:/usr/local/share/doc/kurd-node/LIVE-DATA-PLANE.md
Requires=kurd-node.socket
After=local-fs.target network-online.target time-sync.target systemd-networkd.service unbound.service kurd-node.socket
Wants=network-online.target time-sync.target systemd-networkd.service unbound.service
ConditionPathExists=/var/lib/kurd-node/state.kurd-state

[Service]
Type=simple
User=kurd-node
Group=kurd-node
UMask=0077
ExecStartPre=/usr/local/lib/kurd-node/preflight.sh --runtime --port 443 --allow-systemd-socket
ExecStart=/usr/local/bin/kurd-node serve --data-dir /var/lib/kurd-node --port 443 --control-socket /run/kurd-node/control.sock
ExecReload=/usr/local/bin/kurdctl node reload --data-dir /var/lib/kurd-node --control-socket /run/kurd-node/control.sock
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/kurd-node
RuntimeDirectory=kurd-node
RuntimeDirectoryMode=0700
StateDirectory=kurd-node
StateDirectoryMode=0700
LimitNOFILE=4096
TasksMax=128
MemoryMax=512M
MemorySwapMax=0
LimitCORE=0
CoredumpFilter=0x0

[Install]
WantedBy=multi-user.target
