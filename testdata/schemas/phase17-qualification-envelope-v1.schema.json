{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kurdistanvpn.org/schemas/phase17-qualification-envelope-v1.schema.json",
  "title": "Kurdistan Phase 17 signed qualification envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "statementType", "keyId", "payload", "signature"],
  "properties": {
    "schema": {"const": "kurdistan-phase17-qualification-envelope-v1"},
    "statementType": {"enum": ["RC_LOCKED", "ATTEMPT", "SOAK_READY", "SOAK_CONSUMED", "SUPERSEDE", "EVIDENCE_FINAL"]},
    "keyId": {"$ref": "#/$defs/digest"},
    "payload": {"type": "object"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
  },
  "oneOf": [
    {"properties": {"statementType": {"const": "RC_LOCKED"}, "payload": {"$ref": "#/$defs/rcLocked"}}},
    {"properties": {"statementType": {"const": "ATTEMPT"}, "payload": {"$ref": "#/$defs/attempt"}}},
    {"properties": {"statementType": {"const": "SOAK_READY"}, "payload": {"$ref": "#/$defs/soakReady"}}},
    {"properties": {"statementType": {"const": "SOAK_CONSUMED"}, "payload": {"$ref": "#/$defs/soakConsumed"}}},
    {"properties": {"statementType": {"const": "SUPERSEDE"}, "payload": {"$ref": "#/$defs/supersede"}}},
    {"properties": {"statementType": {"const": "EVIDENCE_FINAL"}, "payload": {"$ref": "#/$defs/evidenceFinal"}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "hex40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "safeCode": {"type": "string", "pattern": "^[A-Z0-9_-]{1,64}$"},
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha256", "productSha256", "harnessSha256", "workloadSha256", "verifierSha256", "candidateId"],
      "properties": {
        "sourceSha256": {"$ref": "#/$defs/digest"},
        "productSha256": {"$ref": "#/$defs/digest"},
        "harnessSha256": {"$ref": "#/$defs/digest"},
        "workloadSha256": {"$ref": "#/$defs/digest"},
        "verifierSha256": {"$ref": "#/$defs/digest"},
        "candidateId": {"$ref": "#/$defs/digest"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha", "treeSha", "roots", "comparisonSha256"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"},
        "commitSha": {"$ref": "#/$defs/hex40"},
        "treeSha": {"$ref": "#/$defs/hex40"},
        "roots": {"$ref": "#/$defs/roots"},
        "comparisonSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "rcLocked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "candidate", "authorizationId", "issuedAt"],
      "properties": {
        "schema": {"const": "kurdistan-phase17-rc-locked-v1"},
        "candidate": {"$ref": "#/$defs/candidate"},
        "authorizationId": {"$ref": "#/$defs/hex32"},
        "issuedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "candidateId", "sequence", "previousEntrySha256", "state", "attemptId", "mode", "rcLockedSha256", "authorizationSha256", "environmentSha256", "preflightSha256", "outcome", "resultSha256", "recordedAt"],
      "properties": {
        "schema": {"const": "kurdistan-phase17-attempt-v1"},
        "candidateId": {"$ref": "#/$defs/digest"},
        "sequence": {"type": "integer", "minimum": 1},
        "previousEntrySha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
        "state": {"enum": ["BEGIN", "TERMINAL"]},
        "attemptId": {"$ref": "#/$defs/hex32"},
        "mode": {"enum": ["Functional", "Stress", "Soak60m", "Soak90m", "Soak120m", "Soak12h"]},
        "rcLockedSha256": {"$ref": "#/$defs/digest"},
        "authorizationSha256": {"$ref": "#/$defs/digest"},
        "environmentSha256": {"$ref": "#/$defs/digest"},
        "preflightSha256": {"$ref": "#/$defs/digest"},
        "outcome": {"type": "string", "pattern": "^(|PASS|FAIL_PRODUCT|FAIL_PRIVACY|FAIL_HARNESS|ABORT_ENVIRONMENT|INVALID_IDENTITY|INCONCLUSIVE)$"},
        "resultSha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
        "recordedAt": {"$ref": "#/$defs/timestamp"}
      },
      "oneOf": [
        {"properties": {"state": {"const": "BEGIN"}, "outcome": {"const": ""}, "resultSha256": {"const": ""}}},
        {"properties": {"state": {"const": "TERMINAL"}, "outcome": {"enum": ["PASS", "FAIL_PRODUCT", "FAIL_PRIVACY", "FAIL_HARNESS", "ABORT_ENVIRONMENT", "INVALID_IDENTITY", "INCONCLUSIVE"]}, "resultSha256": {"$ref": "#/$defs/digest"}}}
      ]
    },
    "soakReady": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "candidateId", "rcLockedSha256", "evidenceIndexSha256", "priorStressResultSha256", "ledgerHeadSha256", "authorizationId", "issuedAt"],
      "properties": {
        "schema": {"const": "kurdistan-phase17-soak-ready-v1"},
        "candidateId": {"$ref": "#/$defs/digest"},
        "rcLockedSha256": {"$ref": "#/$defs/digest"},
        "evidenceIndexSha256": {"$ref": "#/$defs/digest"},
        "priorStressResultSha256": {"$ref": "#/$defs/digest"},
        "ledgerHeadSha256": {"$ref": "#/$defs/digest"},
        "authorizationId": {"$ref": "#/$defs/hex32"},
        "issuedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "soakConsumed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "candidateId", "sequence", "previousEntrySha256", "soakReadySha256", "rcLockedSha256", "attemptId", "environmentSha256", "preflightSha256", "consumedAt"],
      "properties": {
        "schema": {"const": "kurdistan-phase17-soak-consumed-v1"},
        "candidateId": {"$ref": "#/$defs/digest"},
        "sequence": {"type": "integer", "minimum": 1},
        "previousEntrySha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"},
        "soakReadySha256": {"$ref": "#/$defs/digest"},
        "rcLockedSha256": {"$ref": "#/$defs/digest"},
        "attemptId": {"$ref": "#/$defs/hex32"},
        "environmentSha256": {"$ref": "#/$defs/digest"},
        "preflightSha256": {"$ref": "#/$defs/digest"},
        "consumedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "supersede": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "candidateId", "newCandidateId", "reasonCode", "affectedRoots", "requiredReruns", "ledgerHeadSha256", "issuedAt"],
      "properties": {
        "schema": {"const": "kurdistan-phase17-supersede-v1"},
        "candidateId": {"$ref": "#/$defs/digest"},
        "newCandidateId": {"$ref": "#/$defs/digest"},
        "reasonCode": {"$ref": "#/$defs/safeCode"},
        "affectedRoots": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/safeCode"}},
        "requiredReruns": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/safeCode"}},
        "ledgerHeadSha256": {"$ref": "#/$defs/digest"},
        "issuedAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "evidenceFinal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "candidateId", "soakResultSha256", "sanitizedEvidenceSha256", "ledgerHeadSha256", "issuedAt"],
      "properties": {
        "schema": {"const": "kurdistan-phase17-evidence-final-v1"},
        "candidateId": {"$ref": "#/$defs/digest"},
        "soakResultSha256": {"$ref": "#/$defs/digest"},
        "sanitizedEvidenceSha256": {"$ref": "#/$defs/digest"},
        "ledgerHeadSha256": {"$ref": "#/$defs/digest"},
        "issuedAt": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
