{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kurdistanvpn.org/schemas/phase17-owned-vps-preflight-v1.schema.json",
  "title": "Kurdistan Phase 17 owner-VPS launch preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "preflightId", "environmentSha256", "status", "hostClass", "os", "arch", "systemd", "networkd", "nft", "unbound", "tun", "timeSynchronized", "hostClockToVps", "memory", "disk", "ipv4", "ipv6", "ipv6Global", "ipv6DefaultRoute", "ipv6Forwarding", "ipv6NftPolicy", "ipv6External", "sudo", "rawLogRetained"],
  "properties": {
    "schema": {"const": "kurdistan-phase17-owned-vps-preflight-v1"},
    "preflightId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "environmentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "PASS"},
    "hostClass": {"const": "OWNER_CONTROLLED_VPS"},
    "os": {"const": "linux"},
    "arch": {"const": "amd64"},
    "systemd": {"const": true},
    "networkd": {"const": true},
    "nft": {"const": true},
    "unbound": {"const": true},
    "tun": {"const": true},
    "timeSynchronized": {"const": true},
    "hostClockToVps": {"const": true},
    "memory": {"const": true},
    "disk": {"const": true},
    "ipv4": {"const": true},
    "ipv6": {"type": "boolean"},
    "ipv6Global": {"type": "boolean"},
    "ipv6DefaultRoute": {"type": "boolean"},
    "ipv6Forwarding": {"type": "boolean"},
    "ipv6NftPolicy": {"type": "boolean"},
    "ipv6External": {"type": "boolean"},
    "sudo": {"const": true},
    "rawLogRetained": {"const": false}
  }
}
