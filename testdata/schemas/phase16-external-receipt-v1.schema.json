{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kurdistan.invalid/schemas/phase16-external-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","kind","subjectCommit","subjectTree","policyDigest","startedAt","finishedAt","result","artifactDigests","limitations"],
  "properties": {
    "schema": {"const":"phase16-external-receipt-v1"},
    "kind": {"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,63}$"},
    "subjectCommit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "subjectTree": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "policyDigest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "startedAt": {"type":"string","format":"date-time"},
    "finishedAt": {"type":"string","format":"date-time"},
    "result": {"enum":["PASS","FAIL"]},
    "artifactDigests": {"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "limitations": {"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":256}}
  }
}
