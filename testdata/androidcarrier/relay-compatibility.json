    "relay_carrier_incompatible",
    "relay_profile_expired",
    "relay_rotation_window_invalid"
  ],
  "profile_identity_bound": true,
  "relay_identity_bound": true,
  "relay_auth_checked": true,
  "rotation_window_checked": true,
  "expired_profile_rejected": true,
  "unknown_relay_rejected": true,
  "authenticated_session_established": true,
  "relay_bypass_allowed": false,
  "downgrade_accepted": false,
  "conclusion": "passed"
}
