# Normalize line endings to LF in the repository for all text files.
# Go tooling (gofmt) expects LF; this keeps `gofmt -l` clean on Windows checkouts
# where core.autocrlf would otherwise produce CRLF working-tree files.
* text=auto eol=lf

# Explicit: source and common text formats are LF.
*.go   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.txt  text eol=lf
*.kt   text eol=lf
*.kts  text eol=lf
*.xml  text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.c    text eol=lf
*.h    text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
*.jar binary
*.so binary
